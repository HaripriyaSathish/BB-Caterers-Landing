# Copy to .env and fill in your values.
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
# Public URL of the backend, e.g. https://bbcaterers.in (empty = auto-detect)
APP_URL=
FRONTEND_URL=https://bbcaterers.in
CORS_ORIGINS=https://bbcaterers.in,https://www.bbcaterers.in

# Generate with:  php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Local (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bb_caterers
DB_USERNAME=root
DB_PASSWORD=

# --- Render (Neon PostgreSQL) — set these in Render, not in this file ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# MEDIA_STORAGE=database

# SMTP is NOT configured here — set it in Admin → SMTP / Email.
