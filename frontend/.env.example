# BB Caterers frontend — only VITE_* values are exposed to the browser. Never put secrets here.

# PHP backend used by the Vite dev proxy (/admin, /api, /media)
VITE_BACKEND_URL=http://127.0.0.1:8090

# API base for the React app. Keep "/api" when the site and backend share a domain.
VITE_API_URL=/api
